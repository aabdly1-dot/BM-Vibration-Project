"""
Training script for ON/OFF Classifier
Finds optimal threshold by analyzing tool and noise data
"""

import numpy as np
import sys
import os

# Add paths
sys.path.append(os.path.join(os.path.dirname(__file__), '..', '..', '02_preprocessing', 'scripts'))

from preprocess_pipeline import load_raw_data_from_json
from highpass_filter import filter_triaxial_data
from segmentation import create_overlapping_windows
from onoff_model import OnOffClassifier, calibrate_threshold

def load_and_process_directory(directory_path):
    """Load all JSON files from a directory and process them"""
    all_windows = []
    
    json_files = [f for f in os.listdir(directory_path) if f.endswith('.json')]
    print(f"Loading {len(json_files)} files from {os.path.basename(directory_path)}...")
    
    for json_file in json_files:
        file_path = os.path.join(directory_path, json_file)
        print(f"  Processing {json_file}...")
        
        # Load and process
        df_raw = load_raw_data_from_json(file_path)
        if df_raw is not None:
            df_filtered = filter_triaxial_data(df_raw)
            windows = create_overlapping_windows(df_filtered)
            all_windows.append(windows)
    
    # Concatenate all windows
    if all_windows:
        return np.vstack(all_windows)
    return np.array([])

if __name__ == '__main__':
    print("="*70)
    print("ON/OFF CLASSIFIER TRAINING")
    print("="*70)
    
    # Paths
    data_path = os.path.join(os.path.dirname(__file__), '..', '..', '01_data_collection', 'raw')
    
    # Load ON data (tools)
    drill_path = os.path.join(data_path, 'tool_drill')
    grinder_path = os.path.join(data_path, 'tool_grinder')
    
    on_windows = []
    if os.path.exists(drill_path):
        drill_windows = load_and_process_directory(drill_path)
        if len(drill_windows) > 0:
            on_windows.append(drill_windows)
    
    if os.path.exists(grinder_path):
        grinder_windows = load_and_process_directory(grinder_path)
        if len(grinder_windows) > 0:
            on_windows.append(grinder_windows)
    
    if on_windows:
        on_windows = np.vstack(on_windows)
    else:
        print("ERROR: No ON data found!")
        sys.exit(1)
    
    # Load OFF data (noise)
    walking_path = os.path.join(data_path, 'noise_walking')
    off_windows = []
    
    if os.path.exists(walking_path):
        off_windows = load_and_process_directory(walking_path)
    
    if len(off_windows) == 0:
        print("WARNING: No OFF data found. Using default threshold.")
        classifier = OnOffClassifier(magnitude_threshold=2.0)
    else:
        # Calibrate threshold
        print(f"\nCalibrating with {len(on_windows)} ON windows and {len(off_windows)} OFF windows...")
        optimal_threshold = calibrate_threshold(on_windows, off_windows)
        
        # Create and save classifier
        classifier = OnOffClassifier(magnitude_threshold=optimal_threshold)
    
    # Save thresholds
    classifier.save_thresholds()
    
    # Test on training data
    print("\n" + "="*70)
    print("Testing on Training Data")
    print("="*70)
    
    on_predictions = classifier.predict_batch(on_windows)
    on_accuracy = sum(on_predictions) / len(on_predictions) * 100
    print(f"ON data accuracy: {on_accuracy:.1f}% ({sum(on_predictions)}/{len(on_predictions)})")
    
    if len(off_windows) > 0:
        off_predictions = classifier.predict_batch(off_windows)
        off_accuracy = (len(off_predictions) - sum(off_predictions)) / len(off_predictions) * 100
        print(f"OFF data accuracy: {off_accuracy:.1f}% ({len(off_predictions) - sum(off_predictions)}/{len(off_predictions)})")
        
        overall_accuracy = (sum(on_predictions) + (len(off_predictions) - sum(off_predictions))) / (len(on_predictions) + len(off_predictions)) * 100
        print(f"\nOverall Accuracy: {overall_accuracy:.1f}%")
    
    print("\n✓ Training complete!")

